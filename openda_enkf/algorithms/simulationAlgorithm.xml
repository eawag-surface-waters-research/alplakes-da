<?xml version="1.0" encoding="UTF-8"?>
<SequentialSimulationConfig xmlns="http://www.openda.org"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.openda.org http://schemas.openda.org/algorithm/sequentialSimulation.xsd">

    <!--
        SequentialSimulation steps through each observation time, calling
        model.compute(t_obs) for each.  It never reads model.getTimeHorizon(),
        so the ±Infinity that AsciiVectorDataObject returns for timeInfoExchangeItems
        does not cause a crash.

        Before each compute() call OpenDA writes time_start.txt and time_end.txt
        via timeInfoExchangeItems.  For the very first step, time_start may be
        written as -Infinity (model's undeclared initial time); run_simstrat_sim.py
        handles this by falling back to time_end - 1 day.
    -->
    <analysisTimes type="fromObservationTimes" skipAtInitialTime="false"/>
    <mainModel stochParameter="false" stochForcing="false" stochInit="false"/>

</SequentialSimulationConfig>
