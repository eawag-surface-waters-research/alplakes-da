<?xml version="1.0" encoding="UTF-8"?>
<blackBoxStochModel xmlns="http://www.openda.org"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.openda.org http://schemas.openda.org/blackBoxStochModelConfig.xsd">

	<modelConfig>
		<file>./simstratModelEnKF.xml</file>
	</modelConfig>

	<vectorSpecification>
		<!-- Full-grid T profile (576 cells) — updated by the EnKF analysis step -->
		<state>
			<vector id="temperature.state" />
		</state>
		<!-- Predictors: model output at observation depths, matched against stochObserver -->
		<predictor>
			<vector id="T_0m" />
			<vector id="T_10m" />
			<vector id="T_20m" />
		</predictor>
	</vectorSpecification>

</blackBoxStochModel>
