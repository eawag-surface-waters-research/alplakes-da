<?xml version="1.0" encoding="UTF-8"?>
<timeSeriesFormatterConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- time column is Simstrat days (days since Jan 1, 1981).
       Range 16071-16436 covers the full simulation period (Jan 2025 - Jan 2026). -->
  <formatter class="org.openda.exchange.timeseries.DelimitedTextTimeSeriesFormatter">
    <dateTimeSelector type="fixed" timeFormat="mjd">16071,16101</dateTimeSelector>
    <valueSelector>1</valueSelector>
    <delimiter>,</delimiter>
    <commentMarker>#</commentMarker>
    <skipLines>1</skipLines>
  </formatter>
  <timeSeries id="T_0m" status="use" standardDeviation="0.5">
    T_0m_real.csv
  </timeSeries>
  <timeSeries id="T_10m" status="use" standardDeviation="0.5">
    T_10m_real.csv
  </timeSeries>
  <timeSeries id="T_20m" status="use" standardDeviation="0.5">
    T_20m_real.csv
  </timeSeries>
</timeSeriesFormatterConfig>
