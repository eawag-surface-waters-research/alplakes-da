# Generated / data folders — keep the (empty) folder via .gitkeep, ignore its contents.
run/*
!run/.gitkeep
inputs/*
!inputs/.gitkeep
logs/*
!logs/.gitkeep
observations/*
!observations/.gitkeep

# Local-only scratch (notes, diagnostic scripts, their outputs) — one folder, ignored wholesale.
local/

# Orphaned generated OpenDA working dir (current runs go to run/openda_<model>_<lake>_<filter>/).
openda_simstrat/

# Tooling / caches / IDE / editor state.
__pycache__/
.idea/
.claude/

# R session state.
.Rhistory
.RData
