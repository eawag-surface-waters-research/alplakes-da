<?xml version="1.0" encoding="UTF-8"?>
<timeSeriesFormatterConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- time column is Simstrat days (days since Jan 1, 1981).
       Range 16071-16436 covers the full simulation period (Jan 2025 - Jan 2026). -->
  <formatter class="org.openda.exchange.timeseries.DelimitedTextTimeSeriesFormatter">
    <dateTimeSelector type="fixed" timeFormat="mjd">16071,16436</dateTimeSelector>
    <valueSelector>1</valueSelector>
    <delimiter>,</delimiter>
    <commentMarker>#</commentMarker>
    <skipLines>1</skipLines>
  </formatter>
  <timeSeries id="T_1m"  status="use" standardDeviation="0.5">T_1m_real.csv</timeSeries>
  <timeSeries id="T_3m"  status="use" standardDeviation="0.5">T_3m_real.csv</timeSeries>
  <timeSeries id="T_5m"  status="use" standardDeviation="0.5">T_5m_real.csv</timeSeries>
  <timeSeries id="T_7m"  status="use" standardDeviation="0.5">T_7m_real.csv</timeSeries>
  <timeSeries id="T_9m"  status="use" standardDeviation="0.5">T_9m_real.csv</timeSeries>
  <timeSeries id="T_11m" status="use" standardDeviation="0.5">T_11m_real.csv</timeSeries>
  <timeSeries id="T_13m" status="use" standardDeviation="0.5">T_13m_real.csv</timeSeries>
  <timeSeries id="T_15m" status="use" standardDeviation="0.5">T_15m_real.csv</timeSeries>
  <timeSeries id="T_17m" status="use" standardDeviation="0.5">T_17m_real.csv</timeSeries>
  <timeSeries id="T_19m" status="use" standardDeviation="0.5">T_19m_real.csv</timeSeries>
  <timeSeries id="T_21m" status="use" standardDeviation="0.5">T_21m_real.csv</timeSeries>
  <timeSeries id="T_25m" status="use" standardDeviation="0.5">T_25m_real.csv</timeSeries>
  <timeSeries id="T_30m" status="use" standardDeviation="0.5">T_30m_real.csv</timeSeries>
  <timeSeries id="T_35m" status="use" standardDeviation="0.5">T_35m_real.csv</timeSeries>
  <timeSeries id="T_40m" status="use" standardDeviation="0.5">T_40m_real.csv</timeSeries>
</timeSeriesFormatterConfig>
