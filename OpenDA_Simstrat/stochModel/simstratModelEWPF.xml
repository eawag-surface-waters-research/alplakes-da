<?xml version="1.0" encoding="UTF-8"?>
<blackBoxModelConfig xmlns="http://www.openda.org"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.openda.org http://schemas.openda.org/blackBoxModelConfig.xsd">

	<wrapperConfig>
		<file>simstratWrapperEnKF.xml</file>
	</wrapperConfig>

	<aliasValues>
		<alias key="templateDir"  value="template" />
		<alias key="instanceDir"  value="../work_ewpf/work" />
		<alias key="binDir"       value="bin" />
		<alias key="configFile"   value="Settings.par" />
		<alias key="stateFile"    value="temperature_state.txt" />
	</aliasValues>

	<timeInfoExchangeItems start="start_time" timeStep="time_step" end="end_time"/>

	<exchangeItems>
		<vector id="start_time"        ioObjectId="time_config" elementId="time_control@1" />
		<vector id="time_step"         ioObjectId="time_config" elementId="time_control@2" />
		<vector id="end_time"          ioObjectId="time_config" elementId="time_control@3" />
		<vector id="temperature.state" ioObjectId="state_temperature" elementId="temperature_state" />
		<vector id="T_1m"              ioObjectId="output" elementId="model.T_1m" />
		<vector id="T_3m"              ioObjectId="output" elementId="model.T_3m" />
		<vector id="T_5m"              ioObjectId="output" elementId="model.T_5m" />
		<vector id="T_7m"              ioObjectId="output" elementId="model.T_7m" />
		<vector id="T_9m"              ioObjectId="output" elementId="model.T_9m" />
		<vector id="T_11m"             ioObjectId="output" elementId="model.T_11m" />
		<vector id="T_13m"             ioObjectId="output" elementId="model.T_13m" />
		<vector id="T_15m"             ioObjectId="output" elementId="model.T_15m" />
		<vector id="T_17m"             ioObjectId="output" elementId="model.T_17m" />
		<vector id="T_19m"             ioObjectId="output" elementId="model.T_19m" />
		<vector id="T_21m"             ioObjectId="output" elementId="model.T_21m" />
		<vector id="T_25m"             ioObjectId="output" elementId="model.T_25m" />
		<vector id="T_30m"             ioObjectId="output" elementId="model.T_30m" />
		<vector id="T_35m"             ioObjectId="output" elementId="model.T_35m" />
		<vector id="T_40m"             ioObjectId="output" elementId="model.T_40m" />
	</exchangeItems>

	<doCleanUp>false</doCleanUp>

</blackBoxModelConfig>
